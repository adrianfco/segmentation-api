# Copy to .env and fill in real values. Never commit .env.

# Application
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO

# Database (Supabase Postgres — use the session pooler connection string)
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Supabase Storage (service role key is server-side only — never expose it)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=segmentation

# Workers
WORKER_CONCURRENCY=2

# Uploads
MAX_UPLOAD_SIZE_MB=10
